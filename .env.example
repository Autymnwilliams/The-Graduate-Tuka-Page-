# Mapbox GL JS public access token (https://account.mapbox.com/access-tokens/).
# Without this set, the map section falls back to a simple pin-list UI.
NEXT_PUBLIC_MAPBOX_TOKEN=

# MongoDB connection string, for reviews and likes.
# A free MongoDB Atlas (M0) cluster is plenty for a pilot: create one at
# https://www.mongodb.com/cloud/atlas, then paste its connection string here.
# Without this set, reviews/likes fall back to in-memory storage that resets
# on every restart — fine for local dev, not production.
MONGODB_URI=

# Google Places API (New) key, for real business photos when a rec has no
# manually-supplied photoUrls. Requires a Google Cloud project with billing
# enabled and the "Places API (New)" enabled — see
# https://console.cloud.google.com/google/maps-apis. Never exposed to the
# client: photos are proxied server-side through /api/rec-photo. Without
# this set, recs with no manual photos just show a category-icon fallback.
GOOGLE_PLACES_API_KEY=

# Gemini API key, for the digital concierge chat (/api/chat) scoped to each
# hotel's own curated recs. Get one at https://aistudio.google.com/apikey.
# Without this set, the chat widget returns a 503 and stays unusable.
GEMINI_API_KEY=

# Uber developer client_id, for the "Get an Uber there" deep link
# (https://developer.uber.com/docs/deeplinks — no approval process needed
# for this pre-filled-destination flow, just create an app in the Uber
# developer dashboard). Without this set, the Uber button doesn't render.
UBER_CLIENT_ID=

# Twilio credentials, for the concierge SMS sent when a guest likes/favorites
# a rec (requires the guest to have also signed up with a phone number).
# Same env var names as the backend_main Express app for consistency.
# Without these set, SMS sends are skipped (logged, not fatal).
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_PHONE_NUMBER=

# Shared passcode for the /[hotelSlug]/staff pages (add/edit/delete recs,
# view guest engagement metrics). There's no per-user auth system anywhere
# in this app yet, so this is one passcode shared across all hotels' staff
# for now. Without this set, the staff pages are unreachable (login always
# fails, on purpose — never falls open).
STAFF_PASSCODE=
