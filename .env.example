# Mapbox GL JS public access token (https://account.mapbox.com/access-tokens/).
# Without this set, the map section falls back to a simple pin-list UI.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Upstash Redis (Vercel KV) REST credentials, for reviews and likes.
# Add "Upstash for Redis" from the Vercel Marketplace/Storage tab and these
# get set automatically. Without them, reviews/likes fall back to in-memory
# storage that resets on every restart — fine for local dev, not production.
KV_REST_API_URL=
KV_REST_API_TOKEN=
